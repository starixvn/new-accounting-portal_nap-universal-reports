@if (System.Configuration.ConfigurationManager.AppSettings["Environment"] == "PRO")
{
    <script type="text/javascript">
        var _paq = _paq || [];
        function injectPiwik() {
            var usernameSpan = document.getElementById("menu-username");
            if (usernameSpan == null || usernameSpan.innerText.length == 0) {
                setTimeout(injectPiwik, 1000);
            }
            else {
                var u = "https://pw.detecas.com/";
                _paq.push(['setTrackerUrl', u + 'piwik.php']);
                _paq.push(['setSiteId', 2]);
                _paq.push(['setUserId', usernameSpan.innerText]);

                var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
                g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = u + 'piwik.js'; s.parentNode.insertBefore(g, s);
            }
        }

        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        injectPiwik();
    </script>
}