<#@ import namespace="System" #>
<#
    var sites = new SiteInfo[]{
         new SiteInfo
        {
            Environment = SiteEnvironment.LOCAL
        },
         new SiteInfo
        {
            Environment = SiteEnvironment.DEV
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.MASTER
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.UAT
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.MNL
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.PRO
        }
    };
#>
<#+
    enum SiteEnvironment
    {
        DEV,
        LOCAL,
        MASTER,
        UAT,
		SIT,
        MNL,
        PRO
    }
    class SiteInfo
    {
        public SiteEnvironment Environment { get; set; }
                
        #region For Webconfig file
        
        public string ErrorMode
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                             return "On";

                    case SiteEnvironment.MNL:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
                    case SiteEnvironment.DEV:
                    case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
                        return "Off";

                    default:
                        return string.Empty;
                }
            }
        }
        
        public string DebugMode
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "false";
                    case SiteEnvironment.MNL:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
                    case SiteEnvironment.DEV:
                    case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
                        return "true";

                    default:
                        return string.Empty;
                }
            }
        }

        public string EnvironmentSettings
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                        return "LIVE";
                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
                    case SiteEnvironment.LOCAL:
                    case SiteEnvironment.DEV:
                    case SiteEnvironment.MASTER:
                        return "UAT";

                    default:
                        return string.Empty;
                }
            }
        }

        public string SiteIdSettings
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
                        return "4";
                    default:
                        return "3";
                }
            }
        }

        public string UMAddress
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "tcp://10.40.40.150:8990/UMControllerInterface";
                    case SiteEnvironment.MNL:
                        return "tcp://10.2.96.1:8990/UMControllerInterface";
                    case SiteEnvironment.UAT:
                        return "tcp://10.40.40.150:8990/UMControllerInterface";	
					case SiteEnvironment.SIT:
						return "http://172.16.4.106:8889/api";				
                    default:
                        return string.Empty;
                }
            }
        }

         public string EnableCheckUM
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                        return "true";

                    case SiteEnvironment.UAT: 
					case SiteEnvironment.SIT: 
                    case SiteEnvironment.DEV:                  
                    case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
                        return "false";

                    default:
                        return string.Empty;
                }
            }
        }

        public string HubUrl
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "http://58.86.55.10/NapSpecialDelete/UserLogin/login";
                    case SiteEnvironment.MNL:
                        return "http://nap-hub.ibcbk.com/NapSpecialDelete/UserLogin/login";

                    case SiteEnvironment.UAT:
                        return "http://58.86.55.10/NapSpecialDelete/UserLogin/login";
					case SiteEnvironment.SIT:
						return "";
                    case SiteEnvironment.DEV:
                    case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
                        return "http://localhost:54332/NAPHub";

                    default:
                        return string.Empty;
                }
            }
        }

        public string StateConnectionString
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "stateConnectionString=\"tcpip=10.40.40.135:42424\"";
                    case SiteEnvironment.MNL:
                        return "stateConnectionString=\"tcpip=10.2.12.10:42424\"";
                    case SiteEnvironment.UAT:
                        return "stateConnectionString=\"tcpip=127.0.0.1:42424\"";
					 case SiteEnvironment.SIT:
						return "stateConnectionString=\"tcpip=172.16.4.107:42424\"";
                    default:
                        return string.Empty;
                }
            }
        }

        public string AuthorizeDomain
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "<add Name=\"58.86.55.10\" Path=\"/AccReport\"></add>";
                    case SiteEnvironment.MNL:
                        return "<add Name=\"10.2.12.8\" Path=\"/AccReport\"></add>";

                    case SiteEnvironment.UAT:
                        return "<add Name=\"58.86.55.10\" Path=\"/AccReport\"></add>";
					case SiteEnvironment.SIT:
						return "";
                    case SiteEnvironment.DEV:
                    case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
                        return "<add Name=\"10.70.70.242:7123\" Path=\"/\" />";

                    default:
                        return string.Empty;
                }
            }
        }

        public string SPName
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                        return "~/App_Data/PRO/";

                    case SiteEnvironment.UAT:
                        return "~/App_Data/UAT/";
					case SiteEnvironment.SIT:
                        return "~/App_Data/SIT/";
                    case SiteEnvironment.DEV:
                        return "~/App_Data/DEV/";
                    case SiteEnvironment.LOCAL:
                        return "~/App_Data/LOCAL/";
                    case SiteEnvironment.MASTER:
                        return "~/App_Data/MASTER/";

                    default:
                        return string.Empty;
                }
            }
        }

		public string FanexLogMSMQ
		{
			get
            {
				switch(Environment)
                {
					case SiteEnvironment.LOCAL:
					case SiteEnvironment.DEV:
                        return @"FormatName:DIRECT=tcp://10.18.200.124/private$/entlib";
						
					case SiteEnvironment.UAT:
                        return @"FormatName:DIRECT=tcp://10.40.40.73/private$/entlib";

                    case SiteEnvironment.PRO:
                        return @"FormatName:DIRECT=http://10.40.40.127/msmq/Private$/entlib";

					case SiteEnvironment.SIT:
                        return @"FormatName:DIRECT=tcp://172.16.4.106/private$/entlib";

                    case SiteEnvironment.MNL:
                        return @"FormatName:DIRECT=tcp://10.2.98.3/private$/entlib";

					default:
                        return string.Empty;
                }
            }
        }

		 public string FanexLogCategory
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.LOCAL:
					case SiteEnvironment.DEV:
                        return "NAP-Report-LOCAL";

					case SiteEnvironment.UAT:
                        return "NAP-Report-UAT";

                    case SiteEnvironment.PRO:
						return "NAP-Report";
					
					case SiteEnvironment.SIT:
						return "NAP-Report-SIT";

                    case SiteEnvironment.MNL:
                        return "NAP-Report";

					default:
                        return string.Empty;
                }
            }
        }

        
		

        #endregion End for Webconfig file
    }
#>