@{
    var napConfig = new
    {
        Today = Convert.ToInt64(DateTime.Now
            .Subtract(new DateTime(1970, 1, 1, 0, 0, 0))
            .TotalMilliseconds),
        RootUrl = Url.Content("~").TrimEnd(new[] { '/' }),
        LegacyPath = ViewBag.LegacyPath
    };

    var isDebuggingEnabled = HttpContext.Current.IsDebuggingEnabled;
}

<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en" data-ng-app="app.companyWinlossApp">
<!--<![endif]-->
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta http-equiv="cleartype" content="on" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewBag.Title</title>
    <link href="~/Scripts/Fanex.Grid.css" rel="stylesheet" />
    <link href="~/Scripts/Fanex.Pagination.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body>
    <nap-header></nap-header>
    <div class="container-fluid">
        @RenderBody()
    </div>
    <script type="text/javascript">
        var napConfig = @Html.Raw(Json.Encode(napConfig));
    </script>
    <script src="~/Scripts/jquery-2.2.0.min.js"></script>
    <script src="~/Scripts/moment.min.js"></script>
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/angular-route.min.js"></script>
    <script src="~/Scripts/angular-moment.min.js"></script>
    <script src="~/javascripts/bootstrap.min.js"></script>
    <script src="~/Scripts/numeral/numeral.min.js"></script>
    <script src="~/Scripts/Fanex.Grid.js"></script>
    <script src="~/Scripts/Fanex.Pagination.js"></script>
    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <script src="~/app/app.js"></script>
        <script src="~/app/app.config.js"></script>
        <script src="~/app/app.constant.js"></script>

        <script src="~/app/common/fanexGridHelper.js"></script>
        <script src="~/app/common/http-response.service.js"></script>
        <script src="~/app/common/logger.js"></script>
        <script src="~/app/common/Blob.js"></script>

        <script src="~/app/components/alert/alert.directive.js"></script>
        <script src="~/app/components/date-picker/date-picker.directive.js"></script>
        <script src="~/app/components/click/click.directive.js"></script>
        <script src="~/app/components/legend/legend.service.js"></script>
        <script src="~/app/components/legend/legend.directive.js"></script>
        <script src="~/app/components/loading/loading.directive.js"></script>
        <script src="~/app/components/header/header.directive.js"></script>
        <script src="~/app/components/header/header.service.js"></script>
        <script src="~/app/components/month-picker/month-picker.directive.js"></script>

        <script src="~/app/legacy-scripts/check-in.js"></script>
    }
    else
    {
        <script src="~/app/app.min.js"></script>
        <script src="~/app/common.min.js"></script>
    }

    @RenderSection("Scripts", false)
</body>
</html>