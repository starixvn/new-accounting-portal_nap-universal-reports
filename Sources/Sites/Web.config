<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core" />
  </configSections>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider,Fanex.Data" resourcePath="App_Data\Local\" enableWatching="0" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.18.200.209\private$\entlib" defaultCategory="NAP-Report-LOCAL" />
  <NapSettings Environment="LOCAL" EnableDirectLogin="true" SiteId="3" UMAddress="" EnableCheckUM="false" UnauthorizeUrl="" EnableReCheckin="true" HubUrl="http://localhost:54332/NAPHub">
    <Domain>
      <add Name="localhost:63738" Path="/" />
    </Domain>
  </NapSettings>
  <connectionStrings configSource="Web.ConnectionString.config" />
  <appSettings configSource="Web.AppSettings.config" />
  <system.web>
    <compilation debug="true" targetFramework="4.6" />
    <pages controlRenderingCompatibilityVersion="4.0" />
    <authentication mode="None">
      <forms ticketCompatibilityMode="Framework40" loginUrl="~/Home/SessionExpired" timeout="2880" defaultUrl="~/Home" />
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <machineKey
      validationKey="1943EDA6B5CFF77FD38E117081C2F45B3F95D0DF979E0257ADF7CDF1D0F53C38E03A6921565FD4504A2E1F846F0F1111361BC806BEA50A9971248696BB2E10BA"
      decryptionKey="8C2026AF7500B2D9960C9B0A6954553F2A4058F9FB6AD168C5C35D9E660879A0"
      validation="SHA1" decryption="AES"

    />
    <sessionState mode="StateServer" cookieless="false" timeout="20000" />
  </system.web>
  <system.webServer>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
    </staticContent>
  </system.webServer>
