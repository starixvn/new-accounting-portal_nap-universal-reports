<?xml version="1.0" encoding="utf-8"?>
<Functions>
  <Function Name="Punter Analysis">
    <Setting Key="Punter-AssociatedAccount" SpName="Acc_Punter_GetAssociatedAccount" DbName="DBDWH.bodb_dwrs.bodbAdminNet" />
    <Setting Key="Punter-BetCount" SpName="Acc_Punter_Top_DrillDownBetcount" DbName="DBDWH.bodb_dwrs.bodbAdminNet" />
    <Setting Key="Punter-BetType" SpName="Acc_Punter_Top_DrillDownUsernameSportType" DbName="DBDWH.bodb_dwrs.bodbAdminNet" />
    <Setting Key="Punter-League" SpName="Acc_Punter_Top_DrillDownUsernameSportBetType" DbName="DBDWH.bodb_dwrs.bodbAdminNet" />
    <Setting Key="Punter-SportType" SpName="Acc_Punter_Top_DrillDownUsername" DbName="DBDWH.bodb_dwrs.bodbAdminNet" />
    <Setting Key="Punter-Summary" SpName="Acc_Punter_TopByUsername" DbName="DBDWH.bodb_dwrs.bodbAdminNet" />
    <Setting Key="Punter-DatabaseReadiness" SpName="Acc_CheckDailyTaskReadiness" DbName="DBDWH.bodb_dwrs.bodbAdminNet" />
    <Setting Key="Punter-UserSiteQuery" SpName="Acc_Punter_GetSiteName" DbName="DBDWH.bodb_dwrs.bodbAdminNet" />

    <Setting Key="Punter-ProductSportBetTypeQuery" SpName="Acc_SelBettypesbySports_DW" DbName="DBDWH.bodb_dwrs.bodbAdminNet" TimeOut="0">
      <Mapping DataField="ind" ObjectProperty="ProductId" />
      <Mapping DataField="Product" ObjectProperty="ProductName" />
      <Mapping DataField="sporttype" ObjectProperty="SportId" />
      <Mapping DataField="SportName" ObjectProperty="SportName" />
      <Mapping DataField="bettype" ObjectProperty="BetTypeId" />
      <Mapping DataField="bettypename" ObjectProperty="BetTypeName" />
    </Setting>
    <Setting Key="Punter-LeagueQuery" SpName="Acc_TopPunterSelLeagues" DbName="DBDWH.bodb_dwrs.bodbAdminNet" TimeOut="0">
      <Mapping DataField="leagueid" ObjectProperty="Id" />
      <Mapping DataField="leaguename" ObjectProperty="Name" />
    </Setting>
    <Setting Key="Punter-AvailabeDatabaseQuery" SpName="Acc_CheckDailyTaskReadiness" DbName="DBDWH.bodb_dwrs.bodbAdminNet" />
    <Setting Key="Punter-AvailableDateRangeQuery" SpName="Acc_Punter_GetDateRangeSupport" DbName="DBDWH.bodb_dwrs.bodbAdminNet" />

  </Function>
</Functions>