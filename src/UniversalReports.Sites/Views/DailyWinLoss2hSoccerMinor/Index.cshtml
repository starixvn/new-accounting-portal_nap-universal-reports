@{
    ViewBag.Title = "Daily Win Loss (2h) Soccer Minor Bet Types";
    ViewBag.AngularAppName = "houseWinlossApp";
    var contentVersion = HttpContext.Current.IsDebuggingEnabled ? "" : "min.";
}

<div class="page-header">
    Main / <span class="active">@ViewBag.Title</span>
</div>
<div data-ng-view></div>
<div data-nap-alert></div>
<div data-nap-loading></div>
@section Styles{
    <link href="~/bundle/house-win-loss-style.css?v=1.0.12" rel="stylesheet" />
}
@section Scripts{
    <script src="~/bundle/daily-winloss-2h-soccer-minor.chunk.js?v=1.0.12"></script>
}

<script type="text/javascript">
    var modePermissions = @Html.Raw(Json.Encode(ViewBag.ModePermissions));
    var productPermissions =@Html.Raw(Json.Encode(ViewBag.ProductPermissions));
</script>