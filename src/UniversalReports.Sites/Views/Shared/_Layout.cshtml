@{
    var napConfig = new
    {
        Today = Convert.ToInt64(DateTime.Now
            .Subtract(new DateTime(1970, 1, 1, 0, 0, 0))
            .TotalMilliseconds),
        RootUrl = ViewBag.RootUrl,
        LegacyPath = ViewBag.LegacyPath,
        BalanceUp = Convert.ToInt64(ViewBag.BalanceUp.BalanceUpDate
            .Subtract(new DateTime(1970, 1, 1, 0, 0, 0))
            .TotalMilliseconds)
    };
    var contentVersion = HttpContext.Current.IsDebuggingEnabled ? "" : "min.";
}

<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en" data-ng-app="app.@ViewBag.AngularAppName" data-ng-strict-di>
<!--<![endif]-->
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta http-equiv="cleartype" content="on" />
    <meta name="description" content="Universal Reports" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewBag.Title</title>
    <link href="~/bundle/app-style.css" rel="stylesheet" />
    @RenderSection("Styles", false)
</head>
<body>
    <div data-nap-header></div>
    <div class="container-fluid">
        @RenderBody()
    </div>
    <script type="text/javascript">
        var napConfig = @Html.Raw(Json.Encode(napConfig));
        if (location.protocol === 'https:'){
            napConfig.RootUrl = napConfig.RootUrl.replace("http://","https://");
        }

    </script>
    <script src="~/bundle/lib.chunk.js?v=1.0.4"></script>
    <script src="~/bundle/app.chunk.js?v=1.0.4"></script>
    @RenderSection("Scripts", false)
</body>
</html>