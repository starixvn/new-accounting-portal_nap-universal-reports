@{
    ViewBag.Title = "NG2 Statistics";
    ViewBag.AngularAppName = "ng2StatisticsApp";
    var contentVersion = HttpContext.Current.IsDebuggingEnabled ? "" : "min.";
}

<div class="page-header">
    Gaming / <span class="active">@ViewBag.Title</span>
</div>
<div data-ng-view></div>
<div data-nap-alert></div>
<div data-nap-loading></div>
@section Styles{
<link href="~/bundle/ng2-statistics-style.css?v=1.0.7" rel="stylesheet" />
}
@section Scripts{
    <script src="~/bundle/ng2-statistics.chunk.js?v=1.0.7"></script>
}