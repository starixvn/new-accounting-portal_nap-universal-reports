<#@ template debug="true" hostspecific="true" language="C#" #>
<#@ import namespace="System.IO" #>
<#@ output extension=".txt" #>
<#@ include file="$(SolutionDir)\Packages\T4.TemplateFileManager.2.2.1\tools\ttinc\TemplateFilemanager.CS.ttinclude" #>
<#@ include file="Configuration.ttinclude" #>
<#
    var manager = TemplateFileManager.Create(this);
    foreach(var site in sites)
    {
        var fileName = string.Format("Web.{0}.config", site.Environment);

        var appSettingsFileName = string.Format("App_Configuration\\{0}\\Web.AppSettings.config", site.Environment);
        var connectionStringFileName = string.Format("App_Configuration\\Web.ConnectionString.{0}.config", site.Environment);

        manager.StartNewFile(fileName);
#>
<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<configSections>
		<section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core" />
		<section name="Fanex.Caching" type="Fanex.Caching.Configuration.CacheSettings, Fanex.Caching" />
		<section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
        <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
	</configSections>
	<NapSettings
		Environment="<#= site.NapEnvironment #>"
		EnableDirectLogin="1"
		SiteId="<#= site.NapSiteId #>"
		UnauthorizeUrl="~/Error/AccessDenied"
		EnableReCheckin="<#= site.NapEnableReCheckin #>"
		HubUrl=""
		ServiceUrls="<#= site.NapServiceUrls #>"
		AccessKey="<#= site.NapAccessKey #>" >
	<Domain>
		<add Name="<#= site.NapDomainName #>" Path="<#= site.NapDomainPath #>" />
	</Domain>
	</NapSettings>
    <ONEbook.UM ServiceUris="<#=site.ONEbookUMAddress#>"
              EnableCheckUM="<#=site.EnableCheckUM#>"
              EnableUnscheduledUM="false"
              UMFrom="01:00"
              UMTo="23:00"
              SiteId="2000000" UMPageUrl="~/UserLogin/Common/Offline">
    </ONEbook.UM>
	<Fanex.Logging msmqPath="<#=site.FanexLogMSMQ#>" defaultCategory="<#=site.FanexLogCategory#>" />
	<Fanex.Caching cacheType="Fanex.Caching.Memory.MemoryCache, Fanex.Caching">
		<connectionSettings>
			<add name="CompactOnMemoryPressure" value="true" />
			<add name="ExpirationScanFrequency" value="1" />
		</connectionSettings>
	</Fanex.Caching>

	<connectionStrings configSource="App_Configuration\Web.ConnectionString.<#=site.Environment#>.config"/>
	<appSettings file="App_Configuration\Web.AppSettings.<#=site.Environment#>.config">
		<add key="webpages:Version" value="2.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="aspnet:UseHostHeaderForRequestUrl" value="True"/>
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />
		<!-- This setting is used for Rocketor only -->
		<add key="StoredProcedurePath" value="App_Data\TEST" />
	</appSettings>

	<system.web>
		<pages controlRenderingCompatibilityVersion="4.0" />
		<compilation debug="<#= site.DebugMode #>" targetFramework="4.6"/>
	
		<authentication mode="Forms">
			<forms
			  name=".REPORTASPXAUTH"
			  ticketCompatibilityMode="Framework40"
			  loginUrl="~/Common/SessionExpired"
			  timeout="20"
			  defaultUrl="~/Home" />
		</authentication>
		<authorization>
			<deny users="?" />
		</authorization>
	
		<sessionState
			cookieName=".Report_ASP.NET_SessionId"
			mode="StateServer" timeout="30" <#=site.StateConnectionString#> />
		<machineKey validationKey="82DD5F7E8AEE17163191F82D6E74F88716B3A834BD6D1DC5F32CB2F613222E36144B019843C69D711C8EE551F341FDFD60B1AB77F943B02A00467A0D2D632EEB"
			decryptionKey="436E102A02B3582E206F1111DC137F5F2BFC57EBFB8ECD6736596ABDA63B9A65"
			validation="SHA1" decryption="AES" />
		<customErrors mode="<#=site.ErrorMode#>" defaultRedirect="~/Views/Errors/GeneralError.htm" />
		<globalization culture="en-US" uiCulture="en-US" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
	</system.web>
<#
    if(site.Environment == SiteEnvironment.DEV){
#>
    <location path="FakeLogin" allowOverride="true">
        <system.web>
          <authorization>
             <allow users="*"/>
          </authorization>
        </system.web>
      </location>
<#
    }
#>
	<system.webServer>
	<handlers>
		<remove name="ExtensionlessUrlHandler-Integrated-4.0" />
		<remove name="OPTIONSVerbHandler" />
		<remove name="TRACEVerbHandler" />
		<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
	</handlers>
	<staticContent>
		<remove fileExtension=".woff" />
		<mimeMap fileExtension=".woff" mimeType="application/font-woff" />
		<remove fileExtension=".woff2" />
		<mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
	</staticContent>
	</system.webServer>
	<runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
