<#@ template debug="true" hostspecific="true" language="C#" #> 
<#@ import namespace="System.IO" #>
<#@ output extension=".txt" #>
<#@ include file="$(SolutionDir)\Packages\T4.TemplateFileManager.2.2.1\tools\ttinc\TemplateFilemanager.CS.ttinclude" #>
<#@ include file="Configuration.ttinclude" #>
<#
    var manager = TemplateFileManager.Create(this);
    foreach(var site in sites)
    {
        var fileName = string.Format("Web.{0}.config", site.Environment);

        var appSettingsFileName = string.Format("App_Configuration\\{0}\\Web.AppSettings.config", site.Environment);
        var connectionStringFileName = string.Format("App_Configuration\\Web.ConnectionString.{0}.config", site.Environment);

        manager.StartNewFile(fileName);
#>
<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<configSections>
		<section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core.Client" />
		<section name="Fanex.Caching" type="Fanex.Caching.Configuration.CacheSettings, Fanex.Caching" />
		<section name="couchbase" type="Couchbase.Configuration.CouchbaseClientSection, Couchbase" />
	</configSections>
	<NapSettings
		Environment="<#= site.NapEnvironment #>"
		EnableDirectLogin="1"
		SiteId="<#= site.NapSiteId #>"
		UnauthorizeUrl="~/Error/AccessDenied"
		EnableReCheckin="<#= site.NapEnableReCheckin #>"
		HubUrl=""
		ServiceUrls="<#= site.NapServiceUrls #>" >
	<Domain>
		<add Name="<#= site.NapDomainName #>" Path="<#= site.NapDomainPath #>" />
	</Domain>
	</NapSettings>
	<Fanex.Caching cacheType="Fanex.Caching.Memory.MemoryCache, Fanex.Caching">
		<connectionSettings>
			<add name="CompactOnMemoryPressure" value="true" />
			<add name="ExpirationScanFrequency" value="1" />
		</connectionSettings>
	</Fanex.Caching>
	<couchbase>
		<servers bucket="Nap-Report" bucketPassword="">
		  <add uri="<#=site.CouchbaseUrl#>" /> 
		</servers>
	</couchbase>
	<connectionStrings configSource="App_Configuration\Web.ConnectionString.<#=site.Environment#>.config"/>
	<appSettings file="App_Configuration\Web.AppSettings.<#=site.Environment#>.config">
		<add key="webpages:Version" value="2.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="aspnet:UseHostHeaderForRequestUrl" value="True"/>
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />
		<!-- This setting is used for Rocketor only -->
		<add key="StoredProcedurePath" value="App_Data" />
	</appSettings>

	<system.web>
		<pages controlRenderingCompatibilityVersion="4.0" />
		<compilation debug="<#= site.DebugMode #>" targetFramework="4.6"/>
	
		<authentication mode="Forms">
			<forms
			  name=".REPORTASPXAUTH"
			  ticketCompatibilityMode="Framework40"
			  loginUrl="~/Common/SessionExpired"
			  timeout="1440"
			  defaultUrl="~/Home" />
		</authentication>
		<authorization>
			<deny users="?" />
		</authorization>
	
		<sessionState
			cookieName=".Report_ASP.NET_SessionId"
			mode="StateServer" timeout="1440" <#=site.StateConnectionString#> />
        <machineKey validationKey="488FB44AD21A43A38AE21A17114E73ADD2054788F1798850512CB0C9ADC5550D804EEBC56D752AF5EF66F69B865BD38908E75E16013F991901BA5ABBB34A291F"
                    decryptionKey="B7271A769CAB3FB8B3700AECCB487C85AF502DB67101FA21C23BBF600BE372EC"
                    validation="SHA1" decryption="AES" />
		<customErrors mode="<#=site.ErrorMode#>" defaultRedirect="~/Views/Errors/GeneralError.htm" />
		<globalization culture="en-US" uiCulture="en-US" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
		<httpRuntime maxRequestLength="1048576" executionTimeout="3600" maxUrlLength="1048576" maxQueryStringLength="1048576" relaxedUrlToFileSystemMapping="true" />
	</system.web>
<#
    if(site.Environment == SiteEnvironment.DEV){
#>
    <location path="FakeLogin" allowOverride="true">
        <system.web>
          <authorization>
             <allow users="*"/>
          </authorization>
        </system.web>
      </location>
<#
    }
#>
	<system.webServer>
	<handlers>
	</handlers>
	<staticContent>
		<remove fileExtension=".woff" />
		<mimeMap fileExtension=".woff" mimeType="application/font-woff" />
		<remove fileExtension=".woff2" />
		<mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
	</staticContent>
	</system.webServer>
