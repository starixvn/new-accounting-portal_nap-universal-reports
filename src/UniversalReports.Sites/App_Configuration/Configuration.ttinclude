<#@ import namespace="System" #>
<#
    var sites = new SiteInfo[]{
         new SiteInfo
        {
            Environment = SiteEnvironment.LOCAL
        },
         new SiteInfo
        {
            Environment = SiteEnvironment.DEV
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.MASTER
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.UAT
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.MNL
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.PRO
        }
    };
#>
<#+
    enum SiteEnvironment
    {
        DEV,
        LOCAL,
        MASTER,
        UAT,
		SIT,
        MNL,
        PRO
    }
    class SiteInfo
    {
        public SiteEnvironment Environment { get; set; }

        #region For Webconfig file

        public string ErrorMode
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                             return "On";

                    case SiteEnvironment.MNL:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
                    case SiteEnvironment.DEV:
                    case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
                        return "Off";

                    default:
                        return string.Empty;
                }
            }
        }

        public string DebugMode
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "false";
                    case SiteEnvironment.MNL:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
                    case SiteEnvironment.DEV:
                    case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
                        return "true";

                    default:
                        return string.Empty;
                }
            }
        }

        public string NapEnvironment
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                        return "LIVE";
                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
                    case SiteEnvironment.LOCAL:
                    case SiteEnvironment.DEV:
                    case SiteEnvironment.MASTER:
                        return "UAT";

                    default:
                        return string.Empty;
                }
            }
        }

        public string NapSiteId
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
                        return "4";
                    default:
                        return "3";
                }
            }
        }

		public string NapEnableReCheckin
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
						return "false";
                    case SiteEnvironment.SIT:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.PRO:
						return "true";
					case SiteEnvironment.MNL:
                        return "false";
					default:
                        return string.Empty;
                }
            }
        }

		public string NapServiceUrls
		 {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
						return "http://ha.nexdev.net:1711/api";
                    case SiteEnvironment.SIT:
						return "http://172.16.4.106:1710/api";
                    case SiteEnvironment.UAT:
						return "http://10.2.27.16:1710/api";
					case SiteEnvironment.PRO:
						return "http://10.40.40.22:1710/api";
					case SiteEnvironment.MNL:
                        return "http://10.2.98.3:1710/api";
					default:
                        return string.Empty;
                }
            }
        }

		public string NapAccessKey
		 {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
						return "HTAiA6W/kzs0PjSnm3ll1kD7tXPyDyO0gTeD8Nz6078=";
                    case SiteEnvironment.SIT:
						return "ZU5inpesUej+dCIxitApgXAiRhK0N7uCuVHCCjPyT9o=";
                    case SiteEnvironment.UAT:
					case SiteEnvironment.PRO:
					case SiteEnvironment.MNL:
                        return "ZU5inpesUej+dCIxitApgXAiRhK0N7uCuVHCCjPyT9o=";
					default:
                        return string.Empty;
                }
            }
        }

		public string NapDomainName
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
						return "localhost:9902";
                    case SiteEnvironment.SIT:
                        return "nap-report.playthefun.com";
                    case SiteEnvironment.UAT:
						return "qa-accrpt.starific.net";
					case SiteEnvironment.PRO:
                        return "58.86.55.10";
					case SiteEnvironment.MNL:
                        return "nap-report.ibcbk.com";
					default:
                        return string.Empty;
                }
            }
        }

		public string NapDomainPath
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
                    case SiteEnvironment.SIT:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.PRO:
					case SiteEnvironment.MNL:
						return "/AccReport";
					default:
                        return string.Empty;
                }
            }
        }

		public string UMAddress
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "tcp://10.40.40.150:8990/UMControllerInterface";
                    case SiteEnvironment.MNL:
                        return "tcp://10.2.96.1:8990/UMControllerInterface";
                    case SiteEnvironment.UAT:
                        return "tcp://10.40.40.150:8990/UMControllerInterface";
					case SiteEnvironment.SIT:
						return "http://172.16.4.106:8889/api";
                    default:
                        return string.Empty;
                }
            }
        }

        public string EnableCheckUM
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                        return "true";

                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
                    case SiteEnvironment.DEV:
                    case SiteEnvironment.LOCAL:
                    case SiteEnvironment.MASTER:
                        return "false";

                    default:
                        return string.Empty;
                }
            }
        }

        public string StateConnectionString
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "stateConnectionString=\"tcpip=10.40.40.22:42424\"";
                    case SiteEnvironment.MNL:
                        return "stateConnectionString=\"tcpip=10.2.12.10:42424\"";
                    case SiteEnvironment.UAT:
                        return "stateConnectionString=\"tcpip=127.0.0.1:42424\"";
					 case SiteEnvironment.SIT:
						return "stateConnectionString=\"tcpip=172.16.4.107:42424\"";
                    default:
                        return "stateConnectionString=\"tcpip=10.35.35.253:42424\"";
                }
            }
        }

		public string FanexLogMSMQ
		{
			get
            {
				switch(Environment)
                {
					case SiteEnvironment.LOCAL:
					case SiteEnvironment.DEV:
                        return @"FormatName:DIRECT=http://10.35.35.253:808/msmq/Private$/entlib";

					case SiteEnvironment.UAT:
                        return @"FormatName:DIRECT=tcp://10.40.40.73/private$/entlib";

                    case SiteEnvironment.PRO:
                        return @"FormatName:DIRECT=http://10.40.40.22/msmq/Private$/entlib";

					case SiteEnvironment.SIT:
                        return @"FormatName:DIRECT=tcp://172.16.4.106/private$/entlib";

                    case SiteEnvironment.MNL:
                        return @"FormatName:DIRECT=tcp://10.2.98.3/private$/entlib";

					default:
                        return string.Empty;
                }
            }
        }

		 public string FanexLogCategory
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.LOCAL:
					case SiteEnvironment.DEV:
                        return "NAP-Report-LOCAL";

					case SiteEnvironment.UAT:
                        return "NAP-Report-UAT";

                    case SiteEnvironment.PRO:
						return "NAP-Report";

					case SiteEnvironment.SIT:
						return "NAP-Report-SIT";

                    case SiteEnvironment.MNL:
                        return "NAP-Report";

					default:
                        return string.Empty;
                }
            }
        }




        #endregion End for Webconfig file
    }
#>