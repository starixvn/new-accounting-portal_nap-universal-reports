<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<configSections>
		<section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core.Client" />
		
	</configSections>
	<NapSettings
		Environment="UAT"
		EnableDirectLogin="1"
		SiteId="3"
		UnauthorizeUrl="~/Error/AccessDenied"
		EnableReCheckin="false"
		HubUrl=""
		ServiceUrls="http://nap_api_netcore.nexdev.net:8787" >
	<Domain>
		<add Name="localhost:9902" Path="/AccReport" />
	</Domain>
	</NapSettings>	
	<connectionStrings configSource="App_Configuration\Web.ConnectionString.DEV.config"/>
	<appSettings file="App_Configuration\Web.AppSettings.DEV.config">
		<add key="webpages:Version" value="2.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="aspnet:UseHostHeaderForRequestUrl" value="True"/>
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />
		<!-- This setting is used for Rocketor only -->
		<add key="StoredProcedurePath" value="App_Data" />
	</appSettings>

	<system.web>
		<pages controlRenderingCompatibilityVersion="4.0" />		
	    <compilation debug="true" targetFramework="4.7.2">
            <assemblies>
                <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
            </assemblies>
        </compilation>
        <httpRuntime targetFramework="4.7.2" maxRequestLength="1048576" executionTimeout="3600" maxUrlLength="1048576" maxQueryStringLength="1048576" relaxedUrlToFileSystemMapping="true" />
		<authentication mode="Forms">
			<forms
			  name=".REPORTASPXAUTH"
			  ticketCompatibilityMode="Framework40"
			  loginUrl="~/Common/SessionExpired"
			  timeout="1440"
			  defaultUrl="~/Home" />
		</authentication>
		<authorization>
			<deny users="?" />
		</authorization>
	
		<sessionState
			cookieName=".Report_ASP.NET_SessionId"
			mode="StateServer" timeout="1440" stateConnectionString="tcpip=10.18.200.131:42424" />
        <machineKey validationKey="488FB44AD21A43A38AE21A17114E73ADD2054788F1798850512CB0C9ADC5550D804EEBC56D752AF5EF66F69B865BD38908E75E16013F991901BA5ABBB34A291F"
                    decryptionKey="B7271A769CAB3FB8B3700AECCB487C85AF502DB67101FA21C23BBF600BE372EC"
                    validation="SHA1" decryption="AES" />
		<customErrors mode="Off" defaultRedirect="~/Views/Errors/GeneralError.htm" />
		<globalization culture="en-US" uiCulture="en-US" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />		
	</system.web>
    <location path="FakeLogin" allowOverride="true">
        <system.web>
          <authorization>
             <allow users="*"/>
          </authorization>
        </system.web>
      </location>
	<system.webServer>
	<handlers>
	</handlers>
	<staticContent>
		<remove fileExtension=".woff" />
		<mimeMap fileExtension=".woff" mimeType="application/font-woff" />
		<remove fileExtension=".woff2" />
		<mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
	</staticContent>
	</system.webServer>
	<runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2"/>
      </dependentAssembly>     
      <dependentAssembly>
        <assemblyIdentity name="ICSharpCode.SharpZipLib" publicKeyToken="1b03e6acf1164f73" culture="neutral"/>
	   <bindingRedirect oldVersion="0.0.0.0-1.1.0.145" newVersion="1.1.0.145"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="MediatR" publicKeyToken="null" culture="neutral"/>
