<configuration>
	<configSections>
		<section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core" />
		<section name="Fanex.Caching" type="Fanex.Caching.Configuration.CacheSettings, Fanex.Caching" />
		<section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
	</configSections>
	<NapSettings
		Environment="UAT"
		EnableDirectLogin="1"
		SiteId="3"
		UnauthorizeUrl="~/Error/AccessDenied"
		EnableReCheckin="false"
		HubUrl=""
		ServiceUrls="http://ha.nexdev.net:1711/api"
		AccessKey="HTAiA6W/kzs0PjSnm3ll1kD7tXPyDyO0gTeD8Nz6078=" >
	<Domain>
		<add Name="localhost:9902" Path="/AccReport" />
	</Domain>
	</NapSettings>
	<Fanex.Logging msmqPath="" defaultCategory="" />
	<Fanex.Caching cacheType="Fanex.Caching.Memory.MemoryCache, Fanex.Caching">
		<connectionSettings>
			<add name="CompactOnMemoryPressure" value="true" />
			<add name="ExpirationScanFrequency" value="1" />
		</connectionSettings>
	</Fanex.Caching>

	<connectionStrings configSource="App_Configuration\Web.ConnectionString.MASTER.config"/>
	<appSettings file="App_Configuration\Web.AppSettings.MASTER.config">
		<add key="webpages:Version" value="2.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="aspnet:UseHostHeaderForRequestUrl" value="True"/>
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />
		<add key="Environment" value="MASTER" />
		<add key="StoredProcedurePath" value="App_Configuration" />
	</appSettings>

	<system.web>
		<pages controlRenderingCompatibilityVersion="4.0" />
		<compilation debug="true" targetFramework="4.6"/>
			<authentication mode="Forms">
			<forms
			  name=".REPORTASPXAUTH"
			  ticketCompatibilityMode="Framework40"
			  loginUrl="~/Common/SessionExpired"
			  timeout="20"
			  defaultUrl="~/Home" />
		</authentication>
		<authorization>
			<deny users="?" />
		</authorization>
			<sessionState
			cookieName=".Report_ASP.NET_SessionId"
			mode="StateServer" timeout="30" stateConnectionString="tcpip=10.35.35.254:42424" />
		<machineKey validationKey="82DD5F7E8AEE17163191F82D6E74F88716B3A834BD6D1DC5F32CB2F613222E36144B019843C69D711C8EE551F341FDFD60B1AB77F943B02A00467A0D2D632EEB"
			decryptionKey="436E102A02B3582E206F1111DC137F5F2BFC57EBFB8ECD6736596ABDA63B9A65"
			validation="SHA1" decryption="AES" />
		<customErrors mode="Off" defaultRedirect="~/Views/Errors/GeneralError.htm" />
		<globalization culture="en-US" uiCulture="en-US" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
	</system.web>
	<system.webServer>
	<handlers>
		<remove name="ExtensionlessUrlHandler-Integrated-4.0" />
		<remove name="OPTIONSVerbHandler" />
		<remove name="TRACEVerbHandler" />
		<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
	</handlers>
	<staticContent>
		<remove fileExtension=".woff" />
		<mimeMap fileExtension=".woff" mimeType="application/font-woff" />
		<remove fileExtension=".woff2" />
		<mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
	</staticContent>
	</system.webServer>
